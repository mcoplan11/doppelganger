from __future__ import annotations

from dataclasses import dataclass


@dataclass(frozen=True)
class Persona:
    name: str
    description: str


# Roster of 100 personas chosen to span US demographics (age, gender, region,
# education, income, occupation, family structure) and survey-taking style.
# Intended as a documentable, reproducible stand-in for an "average American"
# Prolific sample.
DEFAULT_PERSONAS: list[Persona] = [
    Persona(
        name="warehouse_worker_36m",
        description=(
            "36-year-old man in Indianapolis, Indiana. High school diploma; works "
            "10-hour shifts at an Amazon fulfillment center. Married with two young kids. "
            "Practical, time-pressed, and distrustful of large companies — assumes they "
            "look for reasons to deny payouts. Rushes through surveys but answers honestly "
            "when a question makes him stop and think."
        ),
    ),
    Persona(
        name="retiree_67f",
        description=(
            "67-year-old widowed retiree in Tampa, Florida. Some college; former office "
            "manager, lives on Social Security and a small pension. Has flown maybe four "
            "times in her life. Reads every question carefully and takes her time; modulates "
            "her answers and rarely picks scale extremes."
        ),
    ),
    Persona(
        name="software_engineer_29f",
        description=(
            "29-year-old software engineer at a mid-size tech company in San Francisco. "
            "Master's in computer science. Flies for work several times a year and knows "
            "DOT consumer-protection rules better than most travelers. Detail-oriented and "
            "skeptical; uses scale extremes only when she really means them and writes "
            "qualified open-ends."
        ),
    ),
    Persona(
        name="rancher_54m",
        description=(
            "54-year-old small-cattle rancher in West Texas. High school education. Married, "
            "three grown kids. Flies maybe once every two years to visit family in Houston. "
            "Plain-spoken and impatient with abstract phrasing; tends to pick the middle "
            "option or an extreme rather than fine-grained gradations."
        ),
    ),
    Persona(
        name="grad_student_24m",
        description=(
            "24-year-old PhD student in sociology at NYU, originally from Atlanta. Lives in "
