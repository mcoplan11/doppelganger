DATABASE_URL=sqlite:///./app.db
SECRET_KEY=generate-with-python-secrets-token-hex-32

# Gemini backend. Production uses Vertex AI (Google Cloud) so that Cloud billing
# invoices + Gemini observability dashboards exist. Set GEMINI_USE_VERTEX=true
# and provide the GCP project; auth via ADC / GOOGLE_APPLICATION_CREDENTIALS.
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# AI Studio fallback key (used only when GEMINI_USE_VERTEX=false):
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash

RESEND_API_KEY=re_...        # leave blank to print links to stdout (local dev)
FROM_EMAIL=noreply@yourdomain.com

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost:3000
QUALTRICS_DATACENTER=yul1
