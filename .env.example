# Copy this to .env and fill in real values. Never commit .env.

# Qualtrics REST API v3
QUALTRICS_API_TOKEN=your_api_token_here
QUALTRICS_DATACENTER=iad1
QUALTRICS_SURVEY_ID=SV_xxxxxxxxxxxxxxx

# Google Gemini — choose ONE backend:
#
# (A) Vertex AI (Google Cloud). Auth via Application Default Credentials
#     (`gcloud auth application-default login`) or a service-account key in
#     GOOGLE_APPLICATION_CREDENTIALS. Produces Cloud billing invoices + Vertex
#     model-observability dashboards. Set:
GEMINI_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# NOTE: gemini-3.5-flash is served on Vertex's "global" endpoint, not regional.
GOOGLE_CLOUD_LOCATION=global
#
# (B) Gemini Developer API (AI Studio) — fallback. Set GEMINI_USE_VERTEX=false
#     and provide a key:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
